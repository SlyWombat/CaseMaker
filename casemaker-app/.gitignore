# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Keep-before/keep-after snapshots of dist used to compare builds by eye —
# `dist/` alone does not match `dist-180-before/` (2026-10-07).
dist-*/
*.local

# Issue #71 — operator notes that reference host-specific account names,
# tokens, or URLs (e.g. cPanel deploy walkthrough). Not committed.
local-docs/

# Repo-root .env consumed by scripts/deploy-cpanel.mjs
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated QA/triage output — screenshots and downloaded STLs from the
# harnesses below. The harnesses are tracked; what they emit is not.
qa-*-out/
triage-*-out/

# Makera's reference G-code corpus (#186). GPL-3.0 / unlicensed upstream, Apache-2.0
# here: downloaded on demand by scripts/fetch-reference-gcode.mjs, NEVER committed.
reference-gcode/
