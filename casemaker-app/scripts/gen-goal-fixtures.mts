/**
 * #873 — GENERATE THE GOAL CORPUS, licence-clean.
 *
 * Every mesh under `tests/fixtures/goals/` is built HERE, from primitives this repo already
 * evaluates, so nothing third-party is checked in. The corpus covers the shapes the acceptance
 * tests care about: a relief with a flat back, an organic figure with an underside and undercuts,
 * a near-sphere, a deep narrow pocket, a thin-walled part, plus the awkward imports (an OBJ in
 * inches, a non-manifold shell, a part that does not lie flat) and the other two formats.
 *
 * Run (from casemaker-app):
 *   npx tsx --tsconfig tsconfig.scripts.json scripts/gen-goal-fixtures.mts
 *
 * The outputs are committed; the tests read the files, never regenerate them.
 */

import { mkdirSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { join } from 'node:path';

import ManifoldModule from 'manifold-3d';

import { buildBinaryStl } from '../src/workers/export/stlBinary';
import { buildThreeMf } from '../src/workers/export/threeMf';

const require = createRequire(import.meta.url);
const wasmPath = require.resolve('manifold-3d/manifold.wasm');
const tl = await ManifoldModule({ locateFile: () => wasmPath });
tl.setup();
const { Manifold } = tl;

const OUT = join(process.cwd(), 'tests', 'fixtures', 'goals');
mkdirSync(OUT, { recursive: true });

interface Mesh {
  positions: Float32Array;
  indices: Uint32Array;
}

/** Manifold → the plain mesh the writers take. */
function meshOf(m: InstanceType<typeof Manifold>): Mesh {
  const mesh = m.getMesh();
  return {
    positions: Float32Array.from(mesh.vertProperties),
    indices: Uint32Array.from(mesh.triVerts),
  };
}

function writeStl(name: string, mesh: Mesh): void {
  const buffer = buildBinaryStl([mesh]);
  writeFileSync(join(OUT, name), Buffer.from(buffer));
  console.log(`${name}: ${mesh.indices.length / 3} triangles`);
}

function write3mf(name: string, mesh: Mesh): void {
  const buffer = buildThreeMf([mesh]);
  writeFileSync(join(OUT, name), Buffer.from(buffer));
  console.log(`${name}: ${mesh.indices.length / 3} triangles`);
}

/** An OBJ with a unit statement (or none), one-based faces. */
function writeObj(name: string, mesh: Mesh, unit?: string): void {
  const out: string[] = [];
  out.push('# Case Maker goal corpus — generated by scripts/gen-goal-fixtures.mts (#873)');
  if (unit !== undefined) out.push(`# units: ${unit}`);
  out.push(`# ${mesh.indices.length / 3} triangles`);
  for (let i = 0; i < mesh.positions.length; i += 3) {
    out.push(`v ${mesh.positions[i]} ${mesh.positions[i + 1]} ${mesh.positions[i + 2]}`);
  }
  for (let t = 0; t < mesh.indices.length; t += 3) {
    out.push(`f ${mesh.indices[t]! + 1} ${mesh.indices[t + 1]! + 1} ${mesh.indices[t + 2]! + 1}`);
  }
  writeFileSync(join(OUT, name), `${out.join('\n')}\n`);
  console.log(`${name}: ${mesh.indices.length / 3} triangles`);
}

/** A box from its min corner, mm. */
function box(x0: number, y0: number, z0: number, x1: number, y1: number, z1: number): InstanceType<typeof Manifold> {
  return Manifold.cube([x1 - x0, y1 - y0, z1 - z0]).translate([x0, y0, z0]);
}

/** A cylinder standing on z `z0`, centred at (x, y). */
function post(x: number, y: number, z0: number, z1: number, r: number, segments = 32): InstanceType<typeof Manifold> {
  return Manifold.cylinder(z1 - z0, r, r, segments).translate([x, y, z0]);
}

// ── 1. The relief: a 40 × 30 × 4 plate with a raised dome, flat back ───────────────────────────
{
  const plate = box(0, 0, 0, 40, 30, 4);
  // A raised RECTANGULAR boss, not a dome: a relief's raised surface is its features, and two
  // boxes union into an exact solid with no seam where a curved surface meets a plane.
  const boss = box(10, 10, 4, 30, 20, 7);
  writeStl('relief-plate.stl', meshOf(plate.add(boss)));
  writeObj('relief-plate.obj', meshOf(plate.add(boss)));
}

// ── 2. The figure: a body with legs, a head and an overhanging tail ────────────────────────────
{
  const body = Manifold.sphere(12, 64).scale([1.5, 0.55, 0.6]).translate([24, 20, 17]);
  const neck = post(41, 20, 17, 25, 3.2, 32).rotate([0, -25, 0]).translate([4, 0, 0]);
  const head = Manifold.sphere(6, 48).scale([1.1, 0.9, 0.9]).translate([44, 20, 26]);
  const legs = [
    post(15, 14, 0, 14, 2.4),
    post(15, 26, 0, 14, 2.4),
    post(33, 14, 0, 14, 2.4),
    post(33, 26, 0, 14, 2.4),
  ];
  // The tail leaves the body's rear and runs out over the bed: its UNDERSIDE is the shadow band.
  const tail = Manifold.cylinder(18, 1.6, 1.1, 24).rotate([90, 0, 0]).translate([12, 20, 24]);
  let solid = body.add(head).add(neck).add(tail);
  for (const leg of legs) solid = solid.add(leg);
  writeStl('figure.stl', meshOf(solid));
  // The inches twin: the same figure with its numbers divided by 25.4. The generator writes the
  // OBJ in inches and states so, which is what the import's unit sentence reads.
  const inchMesh = meshOf(solid);
  const turned = new Float32Array(inchMesh.positions.length);
  for (let i = 0; i < turned.length; i++) turned[i] = inchMesh.positions[i]! / 25.4;
  writeObj('figure-inches.obj', { positions: turned, indices: inchMesh.indices }, 'in');
}

// ── 3. The near-sphere ────────────────────────────────────────────────────────────────────────
{
  const sphere = Manifold.sphere(15, 96).translate([15, 15, 15]);
  writeStl('near-sphere.stl', meshOf(sphere));
  write3mf('near-sphere.3mf', meshOf(sphere));
}

// ── 4. The deep narrow pocket: 15 mm deep, 6 mm wide, in a 40 × 40 × 20 block ────────────────
{
  const block = box(0, 0, 0, 40, 40, 20);
  const pocket = box(17, 17, 5, 23, 23, 21);
  writeStl('deep-pocket.stl', meshOf(block.subtract(pocket)));
}

// ── 5. The thin-walled box: 1 mm walls and floor, 40 × 40 × 20 ───────────────────────────────
{
  const outer = box(0, 0, 0, 40, 40, 20);
  const inner = box(1, 1, 1, 39, 39, 21);
  writeStl('thin-wall-box.stl', meshOf(outer.subtract(inner)));
}

// ── 6. The part that does not lie flat: a 30 × 8 × 20 slab standing on its end ─────────────────
// Its own bbox is 30 wide, 8 deep and 20 tall, so "Lay it flat" has a shallower orientation to
// offer (20 → 8) — a part imported standing up that wants turning over.
{
  const slab = Manifold.cube([30, 8, 20]).translate([0, 0, 0]);
  writeStl('tilted-bar.stl', meshOf(slab));
}

// ── 7. The non-manifold shell: an open box, five faces and no lid ────────────────────────────
// Hand-built on purpose: no Manifold produces it, and that is the point of the fixture.
{
  const p: number[] = [];
  const quad = (
    a: [number, number, number],
    b: [number, number, number],
    c: [number, number, number],
    d: [number, number, number],
  ): void => {
    p.push(...a, ...b, ...c, ...a, ...c, ...d);
  };
  quad([0, 0, 0], [40, 0, 0], [40, 40, 0], [0, 40, 0]); // bottom
  quad([0, 0, 0], [40, 0, 0], [40, 0, 20], [0, 0, 20]); // front
  quad([0, 40, 0], [40, 40, 0], [40, 40, 20], [0, 40, 20]); // back
  quad([0, 0, 0], [0, 40, 0], [0, 40, 20], [0, 0, 20]); // left
  quad([40, 0, 0], [40, 40, 0], [40, 40, 20], [40, 0, 20]); // right
  const positions = new Float32Array(p);
  const indices = new Uint32Array(positions.length / 3);
  for (let i = 0; i < indices.length; i++) indices[i] = i;
  writeStl('open-shell.stl', { positions, indices });
}

console.log(`\nWrote the goal corpus to ${OUT}`);
